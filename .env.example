# Postgres connection string. On Vercel, adding Neon from the Storage tab sets DATABASE_URL for you.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: direct (non-pooled) connection used for migrations. Neon on Vercel sets this too.
DATABASE_URL_UNPOOLED=""

# Long random string used to sign login sessions. Generate one with:  openssl rand -base64 32
AUTH_SECRET=""
